# Generated by GPT-6.2 Astra
set root [file normalize [file join [file dirname [info script]] ..]]
set out [file join $root build board_single]
set model [file join $root model role56]
set release [file join $root release role56]
file mkdir $out
file mkdir $release
cd $out
file copy -force [file join $model config.tcl] .
source config.tcl
set design_sources [file join $out sources]
file mkdir $design_sources
set rtl_files {}
foreach src [glob [file join $root rtl * *.sv]] {
    set saved [file join $design_sources [file tail $src]]
    file copy -force $src $saved
    lappend rtl_files $saved
}
set constraints [file join $design_sources camera_npu_nexys_a7.xdc]
file copy -force [file join $root constraints camera_npu_nexys_a7.xdc] $constraints
foreach rom [glob [file join $model *.mem]] {file copy -force $rom .}
set_param general.maxThreads 4
set_part xc7a100tcsg324-1
read_verilog -sv $rtl_files
read_xdc $constraints
set generics {}
foreach setting $settings {lappend generics -generic $setting}
synth_design -top camera_npu_top -part xc7a100tcsg324-1 {*}$generics
if {[get_msg_config -count -severity {CRITICAL WARNING}] > 0} {
    error "Resolve synthesis critical warnings before building the bitstream"
}
opt_design
place_design
phys_opt_design
route_design
report_timing_summary -file [file join $out timing_summary.rpt]
report_utilization -file [file join $out utilization.rpt]
report_drc -file [file join $out drc.rpt]
set setup_path [get_timing_paths -delay_type max -max_paths 1]
set hold_path [get_timing_paths -delay_type min -max_paths 1]
