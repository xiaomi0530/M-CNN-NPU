# Generated by GPT-6.2 Astra
set root [file normalize [file join [file dirname [info script]] ..]]
set project_dir [file join $root build vivado_argmax]
set project_file [file join $project_dir M_CNN_NPU.xpr]
set model [file join $root model role56]
set vectors [file join $root build vectors56]
source [file join $model config.tcl]

set sim_files [glob [file join $root tb *.sv]]
if {[file isdirectory [file join $root dataset]]} {
    if {[info exists ::env(CHARACTER_PYTHON)]} {
        set python [list $::env(CHARACTER_PYTHON)]
    } else {
        set python [auto_execok python]
    }
    if {![llength $python]} {error "Install Python with numpy and Pillow, or set CHARACTER_PYTHON to its executable."}
    exec {*}$python -B -X utf8 [file join $root tools export_vectors56.py] --out $vectors
    lappend sim_files {*}[glob [file join $vectors *.mem]]
}

if {[current_project -quiet] ne ""} {
    if {[file normalize [get_property DIRECTORY [current_project]]] ne $project_dir} {
        error "Open setup_board.tcl in a Vivado session with no other project open."
    }
} elseif {[file exists $project_file]} {
    open_project $project_file
} else {
    create_project M_CNN_NPU $project_dir -part xc7a100tcsg324-1
}
set_property target_language Verilog [current_project]
foreach rom [get_files -quiet -of_objects [get_filesets sources_1] -filter {NAME =~ */model/*/*.mem}] {
    if {[file dirname [file normalize $rom]] ne $model} {remove_files -fileset sources_1 $rom}
}
foreach {fileset paths} [list sources_1 [concat [glob [file join $root rtl * *.sv]] [glob [file join $model *.mem]]] \
                            sim_1 $sim_files \
                            constrs_1 [list [file join $root constraints camera_npu_nexys_a7.xdc]]] {
    foreach src [get_files -quiet -of_objects [get_filesets $fileset] -filter {NAME =~ *.sv}] {
        if {![file exists $src] && ([string match "$root/rtl/*" $src] || [string match "$root/tb/*" $src])} {
            remove_files -fileset $fileset $src
        }
    }
    set missing {}
    foreach item $paths {
        if {![llength [get_files -quiet $item]]} {
            lappend missing $item
        }
    }
    if {[llength $missing]} {add_files -fileset $fileset -norecurse $missing}
}
set_property file_type {Memory Initialization Files} [get_files *.mem]
set_property top camera_npu_top [get_filesets sources_1]
set_property generic $settings [get_filesets sources_1]
set_property top npu_top_tb [get_filesets sim_1]
set_property generic [lsearch -all -inline -not -glob $settings SIDE=*] [get_filesets sim_1]
set_property xsim.simulate.runtime all [get_filesets sim_1]
update_compile_order -fileset sources_1
update_compile_order -fileset sim_1
puts "Ready: $project_file"
